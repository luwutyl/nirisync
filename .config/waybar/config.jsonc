//Modern Vertical
{
    "layer": "top",
    "position": "left",
    "spacing": 0,
    "width": 30, // Slightly wider to fit the numbers comfortably
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 2,
    "margin-right": 2,
    "fixed-center": true,
    "reload_style_on_change": true,

    // ===================================================================
    // MODULE LAYOUT
    // ===================================================================
    "modules-left": [ 
        "custom/cava",
        "clock", 
        "memory",
        "cpu",
        "custom/uptime",
    ],
    
    "modules-center": [ 
        "niri/workspaces", 
    ],
    
    "modules-right": [ 
        "wireplumber",
        "tray",
        "niri/language",
        "custom/notification",
    ],

    // ===================================================================
    // MODULE CONFIGURATION
    // ===================================================================

"memory": {
    "interval": 1,
    "format": "{used:0.1f}G",
    "states": {
        "5": 5, "10": 10, "15": 15, "20": 20, "25": 25, "30": 30, "35": 35, 
        "40": 40, "45": 45, "50": 50, "55": 55, "60": 60, "65": 65, 
        "70": 70, "75": 75, "80": 80, "85": 85, "90": 90, "95": 95
    },
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
},

"wireplumber": {
    "format": "{volume}%",
    "format-muted": "",
    "on-click": "/home/uwuty/.config/waybar/scripts/pavu.sh --app org.pulseaudio.pavucontrol --spawn pavucontrol",
    "max-volume": 150,
    "scroll-step": 5.0,
    "states": {
        "s5": 5, "s10": 10, "s15": 15, "s20": 20, "s25": 25,
        "s30": 30, "s35": 35, "s40": 40, "s45": 45, "s50": 50,
        "s55": 55, "s60": 60, "s65": 65, "s70": 70, "s75": 75,
        "s80": 80, "s85": 85, "s90": 90, "s95": 95, "s100": 100
    },
},

    "custom/uptime": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/uptime.sh",
        "tooltip-format": "{}",
        "interval": 60,
        "return-type": "json",
    },

    "custom/cava": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/cava.sh",
        "tooltip": false,
        "on-click": "playerctl play-pause",
    },

    "cpu": {
        "format": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "interval": 1,
        "rotate": 270,
        "on-click": "/home/uwuty/.config/waybar/scripts/bt.sh --app spbtop --spawn 'kitty --app-id spbtop -e btop'",
        "states": {
            "s5": 5, "s10": 10, "s15": 15, "s20": 20, "s25": 25,
            "s30": 30, "s35": 35, "s40": 40, "s45": 45, "s50": 50,
            "s55": 55, "s60": 60, "s65": 65, "s70": 70, "s75": 75,
            "s80": 80, "s85": 85, "s90": 90, "s95": 95, "s100": 100
        },
    },

    "niri/workspaces": {
        "format": "{icon}",
    },
    
    "tray": {
        "icon-size": 19,
        "show-passive-items": true,
        "spacing": 5,
    },

    "niri/language": {
        "format": " {} ",
        "format-en": "en",
        "format-ru": "ru",
        "on-click": "niri msg action switch-layout next",
        "tooltip": true,
    },
    

    "clock": {
        "format": "{:%H\n%M\n%S}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "interval": 1
    },

    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },


}
